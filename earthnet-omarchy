_HERE = Path(__file__).resolve().parent


def _bootstrap_earthnet():
    candidates = [
        str(_HERE.parent),          # repo layout: parent holds the earthnet pkg
        str(_HERE / "pylib"),       # installed plugin layout: vendored copy
        str(_HERE),                 # earthnet/ copied directly into the plugin
    ]
    for c in candidates:
        if c not in sys.path:
            sys.path.insert(0, c)
    try:
        import earthnet  # noqa: F401
    except Exception as exc:  # pragma: no cover - depends on install layout
        sys.stderr.write(f"[earthnet-omarchy] cannot import earthnet: {exc}\n")
        sys.stderr.flush()
        raise


_bootstrap_earthnet()

