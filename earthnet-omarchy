# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------

class Engine:
    def __init__(self, home_override, demo: bool = False, mmdb: str | None = None):
        self.lock = threading.Lock()
        self.out_lock = threading.Lock()
        self.running = True
        self.demo = demo
        mmdb = str(Path(mmdb).expanduser()) if mmdb else None
        self.geo = GeoResolver(mmdb if mmdb and Path(mmdb).exists() else None)
        self.palette = load_palette()
        self.land = _land_geometry()
        self.land_coarse = _coarse_land() or self.land
        self.borders = _borders_geometry()

        home = home_override
        if home is None:
            home = self.geo.detect_home()
        if home is None:
            home = DEMO_SEATTLE if demo else (0.0, 0.0)
        self.home = home

        self.traces: dict[str, dict] = {}
        self.flow_count = 0
        self.backend = "demo" if demo else "none"
        self.seen_at: dict[str, float] = {}
        self.last_tick = time.monotonic()
        # Throughput: previous cumulative byte total per remote IP and the
        # monotonic time it was sampled, so a poll yields a smoothed rate.
        self.prev_bytes: dict[str, tuple[float, int]] = {}

    # -- output --
    def emit(self, obj: dict) -> None:
        line = json.dumps(obj, separators=(",", ":")) + "\n"
        with self.out_lock:
            try:
                sys.stdout.write(line)
                sys.stdout.flush()
            except Exception:
                self.running = False

    def emit_init(self) -> None:
        self.emit({
            "type": "init",
            "home": {"lat": self.home[0], "lon": self.home[1]},
            "palette": _palette_dict(self.palette),
            "land": self.land,
            "landCoarse": self.land_coarse,
            "borders": self.borders,
            "landRings": len(self.land.get("rings", [])),
            "backend": self.backend,
            "pollInterval": POLL_INTERVAL,
        })

    # -- data --
    def _poll_live(self) -> None:
        flows, backend = conntrack.poll()
        self.backend = backend
        self.flow_count = len(flows)
        # A remote IP can carry several simultaneous flows (and thus several
        # processes). Aggregate what we can for the legend: newest proto/port/
        # state, the set of owning processes, and a combined direction.
        remotes: dict[str, dict] = {}
        for f in flows:
            r = remote_endpoint(f.src, f.dst)
            if r is None:
                continue
            port = f.dport if r == f.dst else f.sport
            agg = remotes.get(r)
            if agg is None:
                agg = {"proto": f.proto, "port": port, "state": f.state,
                       "direction": f.direction, "processes": [], "pids": [],
                       "tx": 0, "rx": 0, "rtt": 0.0, "nflows": 0}
                remotes[r] = agg
            agg["nflows"] += 1
            # keep the most recently seen tuple as representative
            agg["proto"] = f.proto
            agg["port"] = port
            if f.state:
                agg["state"] = f.state
            if f.direction:
                if not agg["direction"]:
                    agg["direction"] = f.direction
                elif agg["direction"] != f.direction:
                    agg["direction"] = "both"
            if f.process and f.process not in agg["processes"]:
                agg["processes"].append(f.process)
                agg["pids"].append(f.pid)
            # sum byte counters across every flow to this remote
            agg["tx"] += f.tx
            agg["rx"] += f.rx
            if f.rtt > 0:
                agg["rtt"] = max(agg["rtt"], f.rtt)
        if not remotes:
            return
        resolved = self.geo.resolve_many(list(remotes.keys()))
        now = time.monotonic()
        for ip, agg in remotes.items():
            g = resolved.get(ip)
            if not g:
                continue
            if g.get("lat") == 0 and g.get("lon") == 0:
                continue
            procs = agg["processes"]
            proc_str = ", ".join(procs[:3]) + (" +%d" % (len(procs) - 3) if len(procs) > 3 else "")
            pid_str = ", ".join(str(p) for p in agg["pids"][:3])
            if len(agg["pids"]) > 3:
                pid_str += " +%d" % (len(agg["pids"]) - 3)
            # Throughput: rate of change of tx+rx since the previous sample.
            total = agg["tx"] + agg["rx"]
            prev = self.prev_bytes.get(ip)
            if prev is not None and now > prev[0] and total >= prev[1]:
                rate = (total - prev[1]) / (now - prev[0])
            else:
                rate = 0.0
            self.prev_bytes[ip] = (now, total)
            existing = self.traces.get(ip)
            if existing is None:
                if len(self.traces) >= MAX_TRACES:
                    worst = min(self.traces, key=lambda k: self.traces[k].get("age", 0))
                    self.traces.pop(worst, None)
                self.traces[ip] = {
                    "id": ip,
                    "lat": g["lat"], "lon": g["lon"],
                    "color": _trace_color(ip),
                    "label": g.get("city") or g.get("country") or "",
                    "city": g.get("city", ""), "country": g.get("country", ""),
                    "cc": (g.get("cc") or "").upper(),
                    "isp": g.get("isp", ""), "org": g.get("org", ""), "as": g.get("as", ""),
                    "proto": agg["proto"], "port": agg["port"], "state": agg["state"],
                    "direction": agg["direction"], "process": proc_str, "pids": pid_str,
                    "nflows": agg["nflows"],
                    "tx": agg["tx"], "rx": agg["rx"], "rate": rate, "rtt": agg["rtt"],
                    "age": 0.0,
                    "phase": (hash(ip) & 0xFFFF) / 65535.0,
                    "alpha": 1.0,
                }
            else:
                existing.update(lat=g["lat"], lon=g["lon"], proto=agg["proto"],
                                port=agg["port"], state=agg["state"], alpha=1.0,
                                direction=agg["direction"], process=proc_str,
                                pids=pid_str, nflows=agg["nflows"],
                                tx=agg["tx"], rx=agg["rx"], rate=rate, rtt=agg["rtt"],
                                isp=g.get("isp", ""), org=g.get("org", ""))
                existing["as"] = g.get("as", existing.get("as", ""))
                existing["label"] = g.get("city") or g.get("country") or existing["label"]
                existing["city"] = g.get("city", existing.get("city", ""))
                existing["country"] = g.get("country", existing.get("country", ""))
                existing["cc"] = (g.get("cc") or existing.get("cc", "")).upper()
            self.seen_at[ip] = now

    def _age_live(self) -> None:
        now = time.monotonic()
        for ip in list(self.traces.keys()):
            t = self.traces[ip]
            t["age"] = t.get("age", 0.0) + now - self.last_tick
            last = self.seen_at.get(ip, now)
            idle = now - last
            if idle <= TRACE_HOLD:
                t["alpha"] = 1.0
            elif idle <= TRACE_HOLD + TRACE_FADE:
                t["alpha"] = max(0.0, 1.0 - (idle - TRACE_HOLD) / TRACE_FADE)
            else:
                self.traces.pop(ip, None)
                self.seen_at.pop(ip, None)
                self.prev_bytes.pop(ip, None)

    def emit_frame(self) -> None:
        if self.demo:
            traces = demo_traces(self.home)
            for t in traces:
                t["age"] = t["age"]
        else:
            traces = list(self.traces.values())
        self.emit({
            "type": "frame",
            "traces": traces,
            "home": {"lat": self.home[0], "lon": self.home[1]},
            "flows": self.flow_count,
            "backend": self.backend,
            "demo": self.demo,
            "t": time.time(),
        })

    def tick(self) -> None:
        if self.demo:
            self.emit_frame()
            return
        with self.lock:
            self.last_tick = time.monotonic()
            self._poll_live()
            self._age_live()
            self.emit_frame()

    def prime(self) -> None:
        """Poll once without emitting a frame, so ``init`` can report the real
        backend and the first frame already carries connections."""
        if self.demo:
            self.backend = "demo"
            return
        with self.lock:
            self.last_tick = time.monotonic()
            try:
                self._poll_live()
            except Exception as e:
                self.emit({"type": "error", "message": str(e)})

    # -- commands --
    def set_mode(self, demo: bool) -> None:
        with self.lock:
            self.demo = demo
            self.traces.clear()
            self.seen_at.clear()
            self.backend = "demo" if demo else "none"
            self.flow_count = 0 if demo else self.flow_count
        self.tick()

    def clear_traces(self) -> None:
        with self.lock:
            self.traces.clear()
            self.seen_at.clear()
        self.tick()

    def refresh(self) -> None:
        with self.lock:
            self.palette = load_palette()
            self.land = _land_geometry()
            self.land_coarse = _coarse_land() or self.land
            self.borders = _borders_geometry()
            self.geo.cache = {}
        self.emit_init()
        self.tick()

    def quit(self) -> None:
        self.running = False


def _reader(engine: Engine) -> None:
    for line in sys.stdin:
        cmd = line.strip().lower()
        if not cmd:
            continue
        if cmd in ("quit", "q", "exit"):
            engine.quit()
            return
        if cmd in ("demo", "mode demo"):
            engine.set_mode(True)
        elif cmd in ("live", "mode live"):
            engine.set_mode(False)
        elif cmd == "refresh":
            engine.refresh()
        elif cmd == "clear":
            engine.clear_traces()
        elif cmd == "poll":
            engine.tick()


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    demo = "--demo" in argv
    home_override = None
    mmdb = None
    for i, a in enumerate(argv):
        if a == "--home" and i + 1 < len(argv):
            try:
                lat, lon = (float(x) for x in argv[i + 1].split(","))
                home_override = (lat, lon)
            except Exception:
                pass
        elif a == "--mmdb" and i + 1 < len(argv):
            mmdb = argv[i + 1]
    if home_override is None:
        home_override = _read_home_override()

    engine = Engine(home_override, demo=demo, mmdb=mmdb)
    engine.prime()
    engine.emit_init()
    engine.tick()

    reader = threading.Thread(target=_reader, args=(engine,), daemon=True)
    reader.start()

    while engine.running:
        time.sleep(POLL_INTERVAL)
        # demo mode wants a smooth pulse, live mode is fine at the poll rate
        if engine.demo:
            engine.emit_frame()
        else:
            engine.tick()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
