def _palette_dict(pal) -> dict:
    def hx(c):
        return "#%02x%02x%02x" % (int(c[0]), int(c[1]), int(c[2]))
    return {
        "space": hx(pal.space),
        "ocean": hx(pal.ocean),
        "land": hx(pal.land),
        "land_hi": hx(pal.land_hi),
        "grid": hx(pal.grid),
        "ring": hx(pal.ring),
        "star": hx(pal.star),
        "trace": hx(pal.trace),
        "trace_hot": hx(pal.trace_hot),
        "trace_far": hx(pal.trace_far),
        "hud_dim": hx(pal.hud_dim),
        "hud_bright": hx(pal.hud_bright),
        "hud_accent": hx(pal.hud_accent),
    }


# ---------------------------------------------------------------------------
# Trace colouring (matches the terminal app)
# ---------------------------------------------------------------------------

def _trace_color(key: str) -> str:
    h = int(hashlib.md5(key.encode()).hexdigest()[:8], 16) / 0xFFFFFFFF
    r, g, b = colorsys.hsv_to_rgb(h, 0.65, 1.0)
    return "#%02x%02x%02x" % (int(r * 255), int(g * 255), int(b * 255))


