def _read_home_override() -> tuple[float, float] | None:
    """A small file the user can drop next to the plugin to pin home without
    needing an internet lookup. Contents: ``LAT,LON`` or a JSON object."""
    for name in ("home.json", "home.txt"):
        p = _HERE / name
        if not p.exists():
            continue
        try:
            text = p.read_text().strip()
        except Exception:
            continue
        if not text:
            continue
        try:
            if text.startswith("{"):
                d = json.loads(text)
                return (float(d["lat"]), float(d["lon"]))
        except Exception:
            pass
        try:
            lat, lon = (float(x) for x in text.replace("\n", "").split(","))
            return (lat, lon)
        except Exception:
            continue
    return None


