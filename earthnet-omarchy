def _download(url: str, dest: Path, timeout: float = 60.0) -> bool:
    import urllib.request
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "earthnet/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = r.read()
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        return True
    except Exception as e:
        print(f"[land] download failed: {url}: {e}", flush=True)
        return False


def _fetch_ne50m() -> dict | None:
    """Load (downloading once) the Natural Earth 50m land geojson."""
    if NE50M_CACHE.exists() and NE50M_CACHE.stat().st_size > 1000:
        try:
            return json.loads(NE50M_CACHE.read_text())
        except Exception:
            pass
    if _download(NE50M_URL, NE50M_CACHE):
        try:
            return json.loads(NE50M_CACHE.read_text())
        except Exception:
            pass
    return None


def _simplify_ring(points: list[tuple[float, float]], tol: float) -> list[tuple[float, float]]:
    """Ramer-Douglas-Peucker, iterative, in lon/lat degrees. Drops points that
    sit within ``tol`` of the line between their neighbours, cutting the 50m
    set's ~60k points without visibly changing the coastline at panel sizes."""
    n = len(points)
    if n < 3:
        return points
    keep = [False] * n
    keep[0] = keep[n - 1] = True
    stack = [(0, n - 1)]
    tol2 = tol * tol
    while stack:
        lo, hi = stack.pop()
        if hi <= lo + 1:
            continue
        ax, ay = points[lo]
        bx, by = points[hi]
        dx, dy = bx - ax, by - ay
        seg2 = dx * dx + dy * dy
        best_d2 = -1.0
        best_i = -1
        for i in range(lo + 1, hi):
            px, py = points[i]
            if seg2 <= 1e-12:
                ex, ey = px - ax, py - ay
            else:
                t = ((px - ax) * dx + (py - ay) * dy) / seg2
                t = 0.0 if t < 0.0 else 1.0 if t > 1.0 else t
                ex, ey = px - (ax + t * dx), py - (ay + t * dy)
            d2 = ex * ex + ey * ey
            if d2 > best_d2:
                best_d2 = d2
                best_i = i
        if best_d2 > tol2:
            keep[best_i] = True
            stack.append((lo, best_i))
            stack.append((best_i, hi))
    return [points[i] for i in range(n) if keep[i]]


def _land_geometry() -> dict:
    """Return ``{"lat": [...], "lon": [...], "rings": [n, ...]}`` for the
    coastlines, computed from the cached Natural Earth geojson."""
    if LAND_CACHE.exists():
        try:
            d = json.loads(LAND_CACHE.read_text())
            if d.get("v") == LAND_CACHE_VERSION and d.get("lat"):
                return d
        except Exception:
            pass

    from earthnet.land import _rings_from_geojson

    gj = _fetch_ne50m()
    # Tolerance in degrees: 0.10 keeps ~14k points (about 3x the old 110m
    # detail) while staying light enough to project + fill every frame.
    tol = 0.10
    if gj is None:
        # Fall back to whatever the terminal app has cached, then its mirrors.
        from earthnet.land import GEOJSON_CACHE, _fetch_geojson
        tol = 0.0  # the 110m set is already coarse; don't simplify
        if GEOJSON_CACHE.exists():
            try:
                gj = json.loads(GEOJSON_CACHE.read_text())
            except Exception:
                gj = None
        if gj is None:
            gj = _fetch_geojson()

    lat: list[float] = []
    lon: list[float] = []
    ring_counts: list[int] = []
    if gj:
        for ring in _rings_from_geojson(gj):
            if tol > 0.0 and len(ring) > 3:
                ring = _simplify_ring(ring, tol)
            if len(ring) < 3:
                continue
            ring_counts.append(len(ring))
            for x, y in ring:
                lon.append(round(float(x), 2))
                lat.append(round(float(y), 2))
    out = {"v": LAND_CACHE_VERSION, "lat": lat, "lon": lon, "rings": ring_counts}
    try:
        LAND_CACHE.parent.mkdir(parents=True, exist_ok=True)
        LAND_CACHE.write_text(json.dumps(out, separators=(",", ":")))
        _write_coarse_land(out)
    except Exception:
        pass
    return out


def _write_coarse_land(fine: dict) -> None:
    """Downsample the prepared coastline to a coarse set for the bar globe."""
    try:
        if LAND_COARSE_CACHE.exists():
            d = json.loads(LAND_COARSE_CACHE.read_text())
            if d.get("v") == LAND_CACHE_VERSION and d.get("lat"):
                return
    except Exception:
        pass
    lat = fine["lat"]; lon = fine["lon"]; counts = fine["rings"]
    olat: list[float] = []; olon: list[float] = []; ocounts: list[int] = []
    off = 0
    step = 4  # keep roughly every 4th point
    for n in counts:
        pts = [(lon[off + i], lat[off + i]) for i in range(n)]
        off += n
        simp = pts[::step]
        if simp[-1] != pts[-1]:
            simp.append(pts[-1])
        if len(simp) < 3:
            continue
        ocounts.append(len(simp))
        for x, y in simp:
            olon.append(x); olat.append(y)
    out = {"v": LAND_CACHE_VERSION, "lat": olat, "lon": olon, "rings": ocounts}
    LAND_COARSE_CACHE.write_text(json.dumps(out, separators=(",", ":")))


def _coarse_land() -> dict | None:
    try:
        d = json.loads(LAND_COARSE_CACHE.read_text())
        if d.get("v") == LAND_CACHE_VERSION and d.get("lat"):
            return d
    except Exception:
        pass
    return None


def _borders_lines(gj: dict) -> list[list[tuple[float, float]]]:
    """Extract line strings (lon, lat) from an admin-boundary geojson."""
    lines: list[list[tuple[float, float]]] = []
    feats = gj.get("features") if gj.get("type") == "FeatureCollection" else [gj]
    for f in feats or []:
        g = f.get("geometry") or {}
        t = g.get("type")
        c = g.get("coordinates")
        parts = []
        if t == "LineString":
            parts = [c]
        elif t == "MultiLineString":
            parts = c
        for ln in parts:
            if ln and len(ln) >= 2:
                lines.append([(float(p[0]), float(p[1])) for p in ln])
    return lines


def _borders_geometry() -> dict:
    """Return ``{"lat": [...], "lon": [...], "lines": [n, ...]}`` for the
    country boundary lines, from the cached/downloaded Natural Earth geojson."""
    if BORDERS_CACHE.exists():
        try:
            d = json.loads(BORDERS_CACHE.read_text())
            if d.get("v") == BORDERS_VERSION and d.get("lat"):
                return d
        except Exception:
            pass

    gj = None
    if NE50M_BORDERS_CACHE.exists() and NE50M_BORDERS_CACHE.stat().st_size > 1000:
        try:
            gj = json.loads(NE50M_BORDERS_CACHE.read_text())
        except Exception:
            gj = None
    if gj is None and _download(NE50M_BORDERS_URL, NE50M_BORDERS_CACHE):
        try:
            gj = json.loads(NE50M_BORDERS_CACHE.read_text())
        except Exception:
            gj = None

    lat: list[float] = []
    lon: list[float] = []
    line_counts: list[int] = []
    if gj:
        for ln in _borders_lines(gj):
            if len(ln) > 3:
                ln = _simplify_ring(ln, 0.08)
            if len(ln) < 2:
                continue
            line_counts.append(len(ln))
            for x, y in ln:
                lon.append(round(float(x), 2))
                lat.append(round(float(y), 2))
    out = {"v": BORDERS_VERSION, "lat": lat, "lon": lon, "lines": line_counts}
    try:
        BORDERS_CACHE.parent.mkdir(parents=True, exist_ok=True)
        BORDERS_CACHE.write_text(json.dumps(out, separators=(",", ":")))
    except Exception:
        pass
    return out


